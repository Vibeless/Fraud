# Copy to .env and fill in real values locally. Never commit .env.
# Staging/production values live in the secrets manager, not here
# (see docs/specs/08_Deployment_Architecture.md §7).

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/campaign_integrity

# --- Redis (cache + BullMQ queue) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SIGNING_KEY=replace-with-a-long-random-value
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=2592000
ARGON2_PEPPER=replace-with-a-long-random-value

# --- X (Twitter) API ---
X_API_CLIENT_ID=
X_API_CLIENT_SECRET=
X_API_BEARER_TOKEN=

# --- App ---
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3001
