# Copy to .env and fill in real values locally. Never commit .env.
# Staging/production values live in the secrets manager, not here
# (see docs/specs/08_Deployment_Architecture.md §7).

# --- Database ---
# DATABASE_URL is the future production override, populated by the hosting platform once chosen.
# Do not construct or use it locally.
# DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=user
DB_PASSWORD=password
DB_NAME=campaign_integrity

# --- Redis (cache + BullMQ queue) ---
# REDIS_URL is the future production override, populated by the hosting platform once chosen.
# Do not construct or use it locally.
# REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Auth ---
JWT_SIGNING_KEY=replace-with-a-long-random-value
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=2592000
ARGON2_PEPPER=replace-with-a-long-random-value

# --- X (Twitter) API ---
X_API_CLIENT_ID=
X_API_CLIENT_SECRET=
X_API_BEARER_TOKEN=

# --- App ---
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3001
