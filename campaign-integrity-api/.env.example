# Copy to .env for local dev. Never commit .env.
# Staging/production values come from the secrets manager, not this file
# (see docs/specs/08_Deployment_Architecture.md §7).

NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3001

# --- Database ---
# DATABASE_URL is the future production override, populated by the hosting platform once chosen.
# Do not construct or use it locally.
# DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=campaign_integrity
DB_PASSWORD=campaign_integrity
DB_NAME=campaign_integrity

# --- Redis (cache + BullMQ queue) ---
# REDIS_URL is the future production override, populated by the hosting platform once chosen.
# Do not construct or use it locally.
# REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Auth ---
JWT_SIGNING_KEY=replace-with-a-long-random-value
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000
ARGON2_PEPPER=replace-with-a-long-random-value

# --- API key hashing ---
API_KEY_PREFIX=ci_live_

# --- X (Twitter) API ---
X_API_BEARER_TOKEN=

# --- Rate limiting (per AAD §3.3) ---
RATE_LIMIT_READ_PER_MINUTE=120
RATE_LIMIT_SUBMIT_PER_MINUTE=30
